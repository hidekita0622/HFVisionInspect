<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="HFVisionInspect.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <startup useLegacyV2RuntimeActivationPolicy="true">
      <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <userSettings>
        <HFVisionInspect.Properties.Settings>
            <setting name="Camera0Tag" serializeAs="String">
                <value>上面</value>
            </setting>
            <setting name="Camera1Tag" serializeAs="String">
                <value>下面</value>
            </setting>
            <setting name="DIOBitPosInspect" serializeAs="String">
                <value>5</value>
            </setting>
            <setting name="DIOBitPosWait" serializeAs="String">
                <value>4</value>
            </setting>
            <setting name="DIOBitCutter" serializeAs="String">
                <value>6</value>
            </setting>
            <setting name="MeanGrayCount" serializeAs="String">
                <value>10</value>
            </setting>
            <setting name="ResultLogBack" serializeAs="String">
                <value>\\DailyBackup</value>
            </setting>
            <setting name="FrontCameraCH" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="RearCameraCH" serializeAs="String">
                <value>1</value>
            </setting>
        </HFVisionInspect.Properties.Settings>
    </userSettings>
</configuration>
